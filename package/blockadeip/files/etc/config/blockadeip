config blockadeip 'main'
        option enabled '1'
        option backend 'auto'
        option set_name 'blockadeip'
        option chain_name 'BLOCKADEIP'
        option threshold '20'
        option window '300'
        option ban_time '0'
        option public_page '1'
        option public_limit '200'
        option public_path '/www/blockadeip'
        option log_path '/etc/blockadeip/blockadeip.log'
        option records_path '/etc/blockadeip/records.tsv'
        option show_full_ip '1'
        option login_button '1'
        option version '1.6.2'
        option repo_url 'https://github.com/sogbtt/openwrt-blockadeip-ipk'
        option changelog 'V1.6.2: 修复规则配置页表单对齐，按钮组与关键词输入区统一缩进；修复日志记录表格原因列过窄导致行高异常；修复通知页 Headers/Body 输入框对齐。V1.6.1: 封禁后端可在页面切换（自动/仅 nftables/ipset），切换时自动清理旧后端残留规则；封禁时长可视化配置（0 为永久），概览页展示后端与时长；新增过期封禁自动清理，避免到期 IP 永久卡在封禁列表。V1.6.0: 封禁后端迁移到原生 nftables，使用独立表 inet blockadeip 与 prerouting/raw 优先级，支持封禁超时，重启自动恢复；保留 ipset/iptables 回退；停用服务会移除拦截规则；批量恢复封禁列表显著降低小内存设备开销。V1.5.0: 通知层抽象，新增通用 Webhook 推送，支持自定义 URL、请求方法、Headers、Body 与 {ip}{reason}{count}{time}{title} 及 JSON/URL 编码变体；Bark 配置保持向后兼容；通知发送移出封禁锁避免阻塞封禁；新增通知测试与模板文件。V1.4.3: 固化已验证的 rpcd 层 banlist_json 修复，避免 LuCI 封禁列表空白；固化 Argon 登录页按钮插入位置与实测 CSS。V1.4.2: 修复已封禁列表原因列显示英文、修复 banlist-json JSON 输出异常、登录页按钮严格按实测样式注入。V1.4.1: 修复Bark提示堆叠、Bark换行显示、已封禁列表为空、表格排版细节。V1.4: 修复Bark保存与测试推送；新增LuCI登录页公开处刑入口；完善中文更新日志；修复表格错位和排序；模拟测试封直接触发封禁；新增清空日志；TAB保存后停留当前页。V1.3: 持久化封禁记录、匹配关键词配置、服务开关、局域网保护、Bark配置。V1.2: 重启恢复封禁、自动识别WEB爆破。V1.1: LuCI基础管理和公开页。'
        option web_patterns 'luci: failed login|Login failed|uwsgi-luci.*failed login|nginx.*login failed|openresty.*login failed'
        option ssh_patterns 'bad password|Failed password|invalid user|Exit before auth|authentication failure|dropbear|sshd'
        option extra_patterns ''

config whitelist 'default'
        list ip '127.0.0.1'
        list ip '192.168.0.0/16'
        list ip '10.0.0.0/8'
        list ip '172.16.0.0/12'

config notify 'push'
        option enabled '0'
        option type 'bark'
        option server ''
        option template 'simple'
        option custom_template '【BlockadeIP】已封禁 {ip}，原因：{reason}，次数：{count}，时间：{time}'
        option webhook_url ''
        option webhook_method 'POST'
        option webhook_content_type 'application/json'
        option webhook_title 'BlockadeIP 安全拦截'
        option webhook_timeout '8'
        option webhook_insecure '0'
        option webhook_body_file '/etc/blockadeip/webhook.body'
        option webhook_headers_file '/etc/blockadeip/webhook.headers'
